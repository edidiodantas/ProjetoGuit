# Credenciais da API Moonshot / Kimi
# Obtenha uma chave gratuita em https://platform.moonshot.cn/ — o plano free
# é suficiente para estudantes e projetos pequenos, com uso limitado.
KIMI_API_KEY=your_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1

# Modelo utilizado. O padrão "kimi-latest" aponta para o modelo mais recente
# disponível para a sua chave. Para economizar no plano gratuito, você pode
# usar um modelo menor, por exemplo: KIMI_MODEL=kimi-k2.5-lite
KIMI_MODEL=kimi-latest

# Configurações do servidor (opcionais)
APP_HOST=0.0.0.0
APP_PORT=8000

# Lista de origens permitidas pelo CORS, separadas por vírgula.
# Use "*" apenas para desenvolvimento local; restrinja ao seu domínio em produção.
CORS_ORIGINS=*

# Tamanho máximo, em caracteres, aceito no campo "code" de /api/composer.
MAX_CODE_CHARS=32000

# Tempo de espera, em segundos, por uma resposta completa da API Kimi/Moonshot.
KIMI_REQUEST_TIMEOUT=60
