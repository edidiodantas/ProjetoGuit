# Moonshot / Kimi API credentials
KIMI_API_KEY=your_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-latest

# Server settings (optional)
APP_HOST=0.0.0.0
APP_PORT=8000

# Comma-separated list of allowed origins for CORS.
# Use "*" only for local development; restrict to your domain in production.
CORS_ORIGINS=*

# Maximum characters accepted in the "code" field of /api/composer.
MAX_CODE_CHARS=32000

# Seconds to wait for a single Kimi/Moonshot chat completion.
KIMI_REQUEST_TIMEOUT=60
