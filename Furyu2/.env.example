# Furyu — configuração local (português do Brasil)
OLLAMA_MODEL=qwen3.5:2b

# URL do servidor Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Pasta onde os PDFs enviados serão salvos
PDF_DIR=./documentos

# Cache/índice do PaperQA
PQA_HOME=./.pqa

# Embedding local via sentence-transformers (NÃO usa OpenAI)
# Prefixo "st-" = modelo HuggingFace local (paper-qa[local])
EMBEDDING_MODEL=st-multi-qa-MiniLM-L6-cos-v1

# Não defina OPENAI_API_KEY. Ollama não precisa de chave.

# E-mail real da escola (Unpaywall exige para achar PDF aberto).
CONTACT_EMAIL=pesquisa@suaescola.edu.br

# Opcional: chave grátis em https://www.semanticscholar.org/product/api
# Sem chave a busca pública funciona, mas tem limite por minuto.
SEMANTIC_SCHOLAR_API_KEY=
