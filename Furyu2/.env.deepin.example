# Modelo sugerido neste Deepin (GTX 750 4GB — GPU antiga; Ollama tende a ir de CPU)
OLLAMA_MODEL=qwen3.5:4b

# URL do servidor Ollama local
OLLAMA_BASE_URL=http://localhost:11434

# Pasta onde os PDFs enviados serão salvos (pode ficar no exFAT)
PDF_DIR=./documentos

# Cache/índice do PaperQA — o setup-deepin.sh aponta isto para linux-env/pqa
PQA_HOME=./.pqa

# Embedding local via sentence-transformers (NÃO usa OpenAI)
EMBEDDING_MODEL=st-multi-qa-MiniLM-L6-cos-v1

# Não defina OPENAI_API_KEY. Ollama não precisa de chave.

# E-mail real da escola (Unpaywall exige para achar PDF aberto).
CONTACT_EMAIL=pesquisa@suaescola.edu.br

# Opcional: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=
