# Amadeus Verbo 0,5B, já criado no Ollama como amadeus-verbo.
# O PC de destino é fraco. Não troque por um modelo de 9B.
OLLAMA_MODEL=amadeus-verbo
OLLAMA_BASE_URL=http://localhost:11434
PDF_DIR=./documentos
PQA_HOME=./.pqa
# Embedding local. O prefixo st- não usa OpenAI.
EMBEDDING_MODEL=st-multi-qa-MiniLM-L6-cos-v1
